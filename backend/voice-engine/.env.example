# Optional settings for the voice engine (`numa-voice`). Nothing here is required: every value has a default.
# numa-voice reads them from the process environment; export them in your shell, e.g. `set -a; . ./.env; set +a`.

# Where model weights live (default: <project>/models).
# NUMA_MODELS_DIR=

# Where Voice Studio keeps saved voices (default: <project>/data/voices). Private: never commit this folder.
# NUMA_VOICES_DIR=

# Default model profile and persona for `run` / `serve`.
# NUMA_VOICE_PROFILE=fast
# NUMA_VOICE_PERSONA=numa-assistant

# Browser origins allowed to connect (comma-separated), e.g. when the frontend runs on another port.
# NUMA_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
