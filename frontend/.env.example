# Optional settings for the browser app. Copy to .env.local to change them; both have working defaults.

# The voice engine's Realtime WebSocket (default shown).
NEXT_PUBLIC_NUMA_VOICE_URL=ws://127.0.0.1:8765/v1/realtime

# Set to "off" to run without the voice engine: a microphone-only preview with a simulated conversation state.
# NEXT_PUBLIC_NUMA_VOICE=off
